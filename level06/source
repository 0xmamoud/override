#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/ptrace.h>

int auth(char *login, unsigned int serial)
{
    unsigned int check;
    int len;
    int i;

    login[strcspn(login, "\n")] = 0;
    len = strnlen(login, 32);
    if (len <= 5)
        return 1;
    if (ptrace(PTRACE_TRACEME, 0, 1, 0) == -1)
    {
        puts("\x1b[32m.---------------------------------.");
        puts("\x1b[31m| !! TAMPERING DETECTED !!  |");
        puts("\x1b[32m'---------------------------------'");
        return 1;
    }
    check = ((signed char)login[3] ^ 0x1337) + 0x5eeded;
    for (i = 0; i < len; i++)
    {
        if ((signed char)login[i] <= 0x1f)
            return 1;
        check += ((signed char)login[i] ^ check) % 1337;
    }
    if (serial == check)
        return 0;
    return 1;
}

int main(void)
{
    char login[32];
    unsigned int serial;

    puts("***********************************");
    puts("*               level06           *");
    puts("***********************************");
    printf("-> Enter Login: ");
    fgets(login, 32, stdin);
    puts("***********************************");
    puts("***** NEW ACCOUNT DETECTED ********");
    puts("***********************************");
    printf("-> Enter Serial: ");
    scanf("%u", &serial);
    if (auth(login, serial) == 0)
    {
        puts("Authenticated!");
        system("/bin/sh");
    }
    return (0);
}
