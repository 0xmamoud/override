#include <stdio.h>
#include <string.h>

char a_user_name[256];

int verify_user_name(void)
{
    puts("verifying username....");
    return (strcmp(a_user_name, "dat_wil"));
}

int verify_user_pass(char *passwd)
{
    return (strcmp(passwd, "admin"));
}

int main(void)
{
    char buffer[64];
    int check;

    puts("********* ADMIN LOGIN PROMPT *********");
    printf("Enter Username: ");
    fgets(a_user_name, 256, stdin);
    check = verify_user_name();
    if (check != 0)
    {
        puts("nope, incorrect username...");
        return (1);
    }
    puts("Enter Password: ");
    fgets(buffer, 100, stdin);
    check = verify_user_pass(buffer);
    if (check != 0)
    {
        puts("nope, incorrect password...");
        return (1);
    }
    return (0);
}
